{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: SENTINEL AI Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: CLI Demo Walkthrough",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo_cli.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Detection Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
